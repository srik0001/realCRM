# ---------------------------------------------------------------------------
# Firebase web app config (Project settings → General → Your apps → Web app).
# These are public identifiers, not secrets; access is enforced by
# database.rules.json and Firebase Authentication.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server only: user management API routes and the seed
# script). Project settings → Service accounts → Generate new private key.
# NEVER expose these to the browser or commit real values.
# ---------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the quotes; literal \n sequences are converted to newlines.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Seed script
# ---------------------------------------------------------------------------
# Password given to every seeded user. Change it after first login.
SEED_DEFAULT_PASSWORD=ChangeMe@123
# Email domain for seeded users (admin@<domain>, priya.presales@<domain>, ...).
SEED_EMAIL_DOMAIN=realcrm.test

# ---------------------------------------------------------------------------
# Local development against the Firebase Emulator Suite (npm run emulators).
# Uncomment all of these to run fully offline with no Firebase project.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-realcrm
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-realcrm-default-rtdb
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
